@model List<EmployeeManagementCore.Models.Employee>

<h2>Employee</h2>
<p>This is Employee Page</p>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Actions</th>
    </tr>

    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Id</td>
            <td>@emp.Name</td>
            <td>@emp.Department</td>
            <td>
                <a asp-action="Edit" asp-route-id="@emp.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@emp.Id">Delete</a>
            </td>
        </tr>
    }
</table>
